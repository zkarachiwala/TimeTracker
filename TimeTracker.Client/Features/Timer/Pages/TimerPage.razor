@page "/"
@attribute [Authorize]
@inject ITimeEntryService TimeEntryService
@inject IProjectService ProjectService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject PendingTimerSync PendingTimerSync
@implements IAsyncDisposable

@using TimeTracker.Client.Features.TimeEntries.Components
@using TimeTracker.Client.Features.Timer

<PageTitle>Timer — TimeTracker</PageTitle>

@* ── Pending-sync card: a stop was queued locally but hasn't reached the server yet ──
     Covers both shapes: a synced entry whose stop failed (pendingStop), and an entry that
     never synced at all and was then stopped (pendingCreate with End set). ── *@
@if (HasPendingSaveIssue)
{
    <MudCard Class="timer-card-running mb-4" Style="border-radius:16px">
        <MudCardContent Style="padding:20px">
            <div class="d-flex justify-space-between align-start mb-2">
                <div class="d-flex align-center gap-2">
                    <span class="project-dot"
                          style="background:@ProjectColors.ForProject(PendingCardProjectId); box-shadow:0 0 0 3px rgba(255,255,255,.25)"></span>
                    <MudText Typo="Typo.overline" Style="color:rgba(255,255,255,.8)">Stopped — not yet saved</MudText>
                </div>
            </div>

            <MudText Typo="Typo.subtitle1" Style="font-weight:500; margin:8px 0 2px">
                @PendingProjectName
            </MudText>
            <MudText Class="tabnum" Style="font-size:3.2rem; font-weight:300; letter-spacing:1px; line-height:1.1">
                @PendingElapsedDisplay
            </MudText>
            <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,.7); margin-bottom:16px">
                Couldn't reach the server — will retry automatically, or sync now
            </MudText>

            <MudButton FullWidth="true" Size="Size.Large" OnClick="RunSync" Disabled="@syncBusy.IsBusy"
                       Variant="Variant.Filled" Color="Color.Warning">
                @if (syncBusy.ShowSpinner)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Sync" Class="mr-2" />
                }
                Sync
            </MudButton>
        </MudCardContent>
    </MudCard>
}
@* ── Running timer card — covers both a synced entry (activeEntry) and one still only
     local, never synced (pendingCreate with no End yet). ── *@
else if (activeEntry is not null || IsRunningLocally)
{
    <MudCard Class="timer-card-running mb-4" Style="border-radius:16px">
        <MudCardContent Style="padding:20px">
            <div class="d-flex justify-space-between align-start mb-2">
                <div class="d-flex align-center gap-2">
                    <span class="project-dot"
                          style="background:@ProjectColors.ForProject(RunningProjectId); box-shadow:0 0 0 3px rgba(255,255,255,.25)"></span>
                    <MudText Typo="Typo.overline" Style="color:rgba(255,255,255,.8)">Tracking now</MudText>
                </div>
                <div class="d-flex align-center gap-1">
                    <span class="pulse-dot"></span>
                    <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,.8); font-size:.7rem">LIVE</MudText>
                </div>
            </div>

            <MudText Typo="Typo.subtitle1" Style="font-weight:500; margin:8px 0 2px">
                @RunningProjectName
            </MudText>
            <MudText Class="tabnum" Style="font-size:3.2rem; font-weight:300; letter-spacing:1px; line-height:1.1">
                @ElapsedDisplay
            </MudText>
            <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,.7); margin-bottom:16px">
                Started @RunningStartUtc!.Value.ToLocalTime().ToString("h:mm tt")
            </MudText>

            <MudButton FullWidth="true" Size="Size.Large" OnClick="RunStop" Disabled="@stopBusy.IsBusy"
                       Style="background:#fff; color:var(--mud-palette-secondary); box-shadow:var(--mud-elevation-4)">
                @if (stopBusy.ShowSpinner)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Stop" Class="mr-2" />
                }
                Stop &amp; save
            </MudButton>
        </MudCardContent>
    </MudCard>
}
else if (_providersReady)
{
    @* ── Idle: start timer card ── *@
    <MudCard Class="mb-4" Style="border-radius:16px" Elevation="4">
        <MudCardContent Style="padding:20px">
            <MudText Typo="Typo.subtitle2" Style="text-transform:uppercase; letter-spacing:.08em; font-weight:600; color:var(--mud-palette-text-secondary)" Class="mb-3">Start a timer</MudText>

            <MudSelect T="int" Label="Project" @bind-Value="selectedProjectId"
                       Variant="Variant.Outlined" Class="mb-3"
                       AnchorOrigin="Origin.BottomCenter">
                @foreach (var p in projects.Where(p => !p.EndDate.HasValue))
                {
                    <MudSelectItem Value="p.Id">@p.Name</MudSelectItem>
                }
            </MudSelect>

            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
                       Size="Size.Large" OnClick="RunStart" Disabled="@startBusy.IsBusy"
                       Style="height:52px; margin-bottom:12px">
                @if (startBusy.ShowSpinner)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Class="mr-2" />
                }
                Start timer
            </MudButton>

            <MudText Typo="Typo.caption" Class="d-flex justify-center mb-2"
                     Style="color:var(--mud-palette-text-secondary)">
                or log a fixed block
            </MudText>
            <div class="d-flex flex-wrap justify-center gap-2">
                @foreach (var mins in new[] { 15, 30, 60, 90 })
                {
                    var busy = LogBlockBusy(mins);
                    <MudChip T="string" Variant="Variant.Outlined"
                             Icon="@(busy.ShowSpinner ? null : Icons.Material.Filled.Bolt)"
                             Disabled="@busy.IsBusy"
                             OnClick="() => RunLogBlock(mins)">
                        @if (busy.ShowSpinner)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        }
                        else
                        {
                            @(mins % 60 == 0 ? $"{mins / 60}h" : $"{mins}m")
                        }
                    </MudChip>
                }
            </div>
        </MudCardContent>
    </MudCard>
}

@* ── Today's progress ── *@
<div class="d-flex justify-space-between align-baseline mb-1">
    <MudText Typo="Typo.h6">Today</MudText>
    <MudText Typo="Typo.body2" Class="tabnum" Style="color:var(--mud-palette-text-secondary)">
        @TodayDisplay / 8h
    </MudText>
</div>
<MudProgressLinear Value="@TodayProgress" Color="Color.Primary" Class="mb-4 tt-progress" Rounded="true" />

@* ── Today's entries ── *@
<MudCard>
    @if (todaysEntries.Count == 0)
    {
        <div class="d-flex flex-column align-center pa-8" style="color:var(--mud-palette-text-disabled)">
            <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Size="Size.Large" />
            <MudText Typo="Typo.body2" Class="mt-2">No time logged yet today</MudText>
        </div>
    }
    else
    {
        <MudList T="string" Style="padding:4px 12px">
            @for (int i = 0; i < todaysEntries.Count; i++)
            {
                var entry = todaysEntries[i];
                <EntryRow Entry="entry" OnEdit="OpenEditSheet" />
                @if (i < todaysEntries.Count - 1)
                {
                    <MudDivider />
                }
            }
        </MudList>
    }
</MudCard>

<div class="bottom-nav-spacer"></div>

@* ── FAB ── *@
<div class="tt-fab">
    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
            OnClick="OpenNewSheet" Disabled="@(!RendererInfo.IsInteractive)" />
</div>

@* ── Entry sheet ── *@
@if (sheetOpen) { <EntrySheet @bind-Open="sheetOpen" Entry="sheetEntry" OnSaved="Reload" /> }

@code {
    private List<ProjectResponse> projects = [];
    private List<TimeEntryResponse> todaysEntries = [];
    private TimeEntryResponse? activeEntry;
    private PendingTimerSync.PendingStop? pendingStop;
    private PendingTimerSync.PendingCreate? pendingCreate;
    private int selectedProjectId;
    private bool sheetOpen;
    private TimeEntryResponse? sheetEntry;
    private PeriodicTimer? ticker;
    private Task? tickTask;
    private bool _providersReady;

    // Disable-immediately / spinner-after-~1s / clear-on-completion state for each independently
    // clickable save action (see BusyState). One per Log Block duration so clicking one doesn't
    // disable or spin the others.
    private readonly BusyState stopBusy = new();
    private readonly BusyState startBusy = new();
    private readonly BusyState syncBusy = new();
    private readonly Dictionary<int, BusyState> logBlockBusy = [];

    private BusyState LogBlockBusy(int minutes) =>
        logBlockBusy.TryGetValue(minutes, out var busy) ? busy : logBlockBusy[minutes] = new BusyState();

    private double TodayMinutes => todaysEntries
        .Where(e => e.End.HasValue)
        .Sum(e => (e.End!.Value - e.Start).TotalMinutes);

    private string TodayDisplay
    {
        get
        {
            var m = (int)TodayMinutes;
            return $"{m / 60}h {m % 60}m";
        }
    }

    private double TodayProgress => Math.Min(100, TodayMinutes / 480 * 100);

    // A create that's still queued locally and hasn't been stopped yet is a timer running
    // without a server Id — same "tracking now" state as activeEntry, just not synced.
    private bool IsRunningLocally => pendingCreate is not null && pendingCreate.End is null;

    // A stop failed to save — either for an already-synced entry (pendingStop) or one that
    // never synced at all and was collapsed into a single create (pendingCreate with End set).
    private bool HasPendingSaveIssue => pendingStop is not null || pendingCreate?.End is not null;

    private DateTime? RunningStartUtc => activeEntry?.Start ?? (IsRunningLocally ? pendingCreate!.Start : null);
    private int RunningProjectId => activeEntry?.Project.Id ?? pendingCreate?.ProjectId ?? 0;
    private string RunningProjectName => activeEntry?.Project.Name
        ?? projects.FirstOrDefault(p => p.Id == pendingCreate?.ProjectId)?.Name ?? "Project";

    private int PendingCardProjectId => pendingStop?.ProjectId ?? pendingCreate?.ProjectId ?? 0;
    private DateTime PendingCardStart => pendingStop?.Start ?? pendingCreate?.Start ?? DateTime.UtcNow;
    private DateTime? PendingCardEnd => pendingStop?.StopUtc ?? pendingCreate?.End;

    private string ElapsedDisplay
    {
        get
        {
            if (RunningStartUtc is null) return "00:00:00";
            var elapsed = DateTime.UtcNow - RunningStartUtc.Value;
            return $"{(int)elapsed.TotalHours:D2}:{elapsed.Minutes:D2}:{elapsed.Seconds:D2}";
        }
    }

    private string PendingElapsedDisplay
    {
        get
        {
            if (PendingCardEnd is null) return "00:00:00";
            var elapsed = PendingCardEnd.Value - PendingCardStart;
            return $"{(int)elapsed.TotalHours:D2}:{elapsed.Minutes:D2}:{elapsed.Seconds:D2}";
        }
    }

    private string PendingProjectName =>
        projects.FirstOrDefault(p => p.Id == PendingCardProjectId)?.Name ?? "Project";

    protected override async Task OnInitializedAsync()
    {
        // Local storage (ILocalStore -> IJSRuntime) is only reachable once WASM has hydrated in
        // the browser — calling it during SSR prerender throws. This method also runs a second
        // time post-hydration (OnInitializedAsync re-runs in WASM), which is when this actually executes.
        if (OperatingSystem.IsBrowser())
        {
            pendingStop = await PendingTimerSync.GetPendingStopAsync();
            pendingCreate = await PendingTimerSync.GetPendingCreateAsync();
            if (pendingStop is not null || pendingCreate is not null)
            {
                await PendingTimerSync.RetryIfAnyAsync();
                // Re-fetch rather than trust the combined bool — a create and a stop are never
                // queued for the same timer at once in practice, but each resolves independently.
                pendingStop = await PendingTimerSync.GetPendingStopAsync();
                pendingCreate = await PendingTimerSync.GetPendingCreateAsync();
            }
        }

        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _providersReady = true;
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task LoadData()
    {
        try
        {
            projects = await ProjectService.GetAllProjects();
            activeEntry = await TimeEntryService.GetActiveTimeEntry();
            todaysEntries = await TimeEntryService.GetTodaysTimeEntries();
            selectedProjectId = projects.FirstOrDefault(p => !p.EndDate.HasValue)?.Id ?? 0;

            // A pending stop means this entry is locally stopped even if the server still
            // reports it active (the save hasn't landed yet) — don't resurrect the running card.
            // A locally-running-but-unsynced timer (pendingCreate, no End) also needs the ticker.
            if (RunningStartUtc is not null && !HasPendingSaveIssue) StartTicker();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Nav.NavigateTo("login", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            // Request aborted during page teardown — not a real error
        }
    }

    private async Task Reload()
    {
        StopTicker();
        await LoadData();
    }

    private void StartTicker()
    {
        StopTicker();
        ticker = new PeriodicTimer(TimeSpan.FromSeconds(1));
        var capturedTicker = ticker;
        tickTask = Task.Run(async () =>
        {
            while (await capturedTicker.WaitForNextTickAsync())
                await InvokeAsync(StateHasChanged);
        });
    }

    private void StopTicker()
    {
        ticker?.Dispose();
        ticker = null;
    }

    private Task RunStart() => startBusy.RunAsync(StartTimer, StateHasChanged);
    private Task RunStop() => stopBusy.RunAsync(StopTimer, StateHasChanged);
    private Task RunSync() => syncBusy.RunAsync(SyncPending, StateHasChanged);
    private Task RunLogBlock(int minutes) => LogBlockBusy(minutes).RunAsync(() => LogBlock(minutes), StateHasChanged);

    private async Task StartTimer()
    {
        if (selectedProjectId <= 0) return;

        // Local-first: PendingTimerSync queues the create in local storage before attempting the
        // network call, so the running card can render immediately below regardless of outcome.
        var synced = await PendingTimerSync.StartAsync(selectedProjectId, DateTime.UtcNow);
        pendingCreate = synced is null ? await PendingTimerSync.GetPendingCreateAsync() : null;
        await Reload();
    }

    private async Task StopTimer()
    {
        var stopUtc = DateTime.UtcNow;

        if (activeEntry is not null)
        {
            // Already synced — Stage A's original stop-by-id flow, unchanged.
            // Reflect "stopped" immediately and locally — don't wait on the network round trip to
            // decide what to show. Otherwise a slow/failed save leaves the running card (and its
            // ticker) showing as if Stop was never pressed, inviting a confusing second click.
            pendingStop = new PendingTimerSync.PendingStop(activeEntry.Id, activeEntry.Project.Id, activeEntry.Start, stopUtc, activeEntry.Note);
            StopTicker();
            StateHasChanged();

            var saved = await PendingTimerSync.StopAsync(activeEntry, stopUtc);
            if (saved)
            {
                pendingStop = null;
                Snackbar.Add("Timer saved", Severity.Success);
                await Reload();
            }
            else
            {
                Snackbar.Add("Couldn't reach the server — click Sync to retry", Severity.Warning);
            }
        }
        else if (IsRunningLocally)
        {
            // Never synced — collapse into a single create carrying both Start and End, rather
            // than a create followed by an update (there's no server Id to update by yet).
            pendingCreate = pendingCreate! with { End = stopUtc };
            StopTicker();
            StateHasChanged();

            var synced = await PendingTimerSync.StopUnsyncedAsync(stopUtc);
            if (synced is not null)
            {
                pendingCreate = null;
                Snackbar.Add("Timer saved", Severity.Success);
                await Reload();
            }
            else
            {
                Snackbar.Add("Couldn't reach the server — click Sync to retry", Severity.Warning);
            }
        }
    }

    private async Task SyncPending()
    {
        var saved = await PendingTimerSync.RetryIfAnyAsync();
        if (saved)
        {
            pendingStop = null;
            pendingCreate = null;
            Snackbar.Add("Timer saved", Severity.Success);
            await Reload();
        }
        else
        {
            Snackbar.Add("Still couldn't reach the server", Severity.Warning);
        }
    }

    private async Task LogBlock(int minutes)
    {
        if (selectedProjectId <= 0) return;
        var start = DateTime.UtcNow.AddMinutes(-minutes);
        try
        {
            // ClientRequestId makes a retried submit idempotency-safe server-side, but this isn't
            // persisted locally — a failed block log doesn't survive a reload (manual retry only,
            // see docs/plans/stage-b-start-timer-offline-plan.md). Full offline persistence for
            // this can be added later without reworking this call, if it's ever needed.
            await TimeEntryService.CreateTimeEntry(new TimeEntryCreateRequest
            {
                ProjectId = selectedProjectId,
                Start = start,
                End = DateTime.UtcNow,
                ClientRequestId = Guid.NewGuid()
            });
            Snackbar.Add($"{minutes}m logged", Severity.Success);
            await Reload();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Couldn't reach the server — try again", Severity.Warning);
        }
    }

    private void OpenNewSheet()
    {
        sheetEntry = null;
        sheetOpen = true;
    }

    private void OpenEditSheet(TimeEntryResponse entry)
    {
        sheetEntry = entry;
        sheetOpen = true;
    }

    public async ValueTask DisposeAsync()
    {
        StopTicker();
        if (tickTask is not null)
            await tickTask.ConfigureAwait(false);
    }
}
